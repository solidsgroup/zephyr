ZEPHYR_ENV=development
ZEPHYR_DATABASE_URL=postgresql+asyncpg://zephyr:zephyr@localhost:5432/zephyr
ZEPHYR_SESSION_SECRET=replace-with-at-least-32-random-characters
ZEPHYR_TOKEN_PEPPER=replace-with-an-independent-random-secret
ZEPHYR_PUBLIC_URL=http://localhost:8000
ZEPHYR_DEV_AUTH=true

# Google OpenID Connect (required in production)
ZEPHYR_GOOGLE_CLIENT_ID=
ZEPHYR_GOOGLE_CLIENT_SECRET=
ZEPHYR_GOOGLE_ALLOWED_DOMAIN=solids.group

# Working artifacts (Google Shared Drive in production)
ZEPHYR_ARTIFACT_STORE=disabled
ZEPHYR_GOOGLE_DRIVE_FOLDER_ID=
ZEPHYR_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
